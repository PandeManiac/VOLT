<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Volt.PlayDemo</RootNamespace>
  </PropertyGroup>

  <!-- SampleGame carries the project's own game code, which is built as a
       separate assembly. Without this the host's default compile glob would
       compile that code (and its generated files) into the host itself. -->
  <ItemGroup>
    <Compile Remove="SampleGame/**" />
    <None Remove="SampleGame/Scripts/bin/**" />
    <None Remove="SampleGame/Scripts/obj/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Volt.Ui/Volt.Ui.csproj" />
    <ProjectReference Include="../../src/Volt.Ui.Vulkan/Volt.Ui.Vulkan.csproj" />
    <ProjectReference Include="../../src/Volt.Editor.Core/Volt.Editor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/Volt.Ui.Vulkan/Shaders/ui.vert.spv"
          Link="Shaders/ui.vert.spv"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Volt.Ui.Vulkan/Shaders/ui.frag.spv"
          Link="Shaders/ui.frag.spv"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
